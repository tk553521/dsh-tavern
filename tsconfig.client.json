{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    /* Browser half: no Node globals. `types: ["node"]` here let client code
       reference `process`/`Buffer` without a warning and mis-inferred
       `setTimeout` as `NodeJS.Timeout`. */
    "types": [],
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/client", "src/types.ts", "src/css-modules.d.ts", "src/client/vendor.d.ts"]
}
