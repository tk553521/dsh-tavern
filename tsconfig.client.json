{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    /* Browser half: no Node globals. `types: ["node"]` here let client code
       reference `process`/`Buffer` without a warning and mis-inferred
       `setTimeout` as `NodeJS.Timeout`. */
    "types": [],
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      /* Not shipped inside the globally installed @deepseek-ai/dsh tree;
         type-only import, resolved against the reference checkout. */
      "@deepseek-ai/dsh-client-ui-slots": [
        "./.ref/dsh/packages/client/ui-slots/src/index.ts"
      ]
    }
  },
  "include": ["src/client", "src/types.ts", "src/css-modules.d.ts"]
}
