{
  /* Editor/tsdown default. The authoritative programs are tsconfig.host.json
     and tsconfig.client.json (`pnpm typecheck` runs both); this file exists so
     an IDE opening any file in src/ resolves imports the same way.

     It deliberately carries NO absolute `paths`. It used to point
     `@deepseek-ai/*` at one machine's npx cache directory — a path that broke
     for every other clone, leaked the author's Windows user name into a public
     repository, and had since stopped existing even locally. `@deepseek-ai/*`
     now resolves through node_modules like any other dependency; see the
     README for how to provide that tree. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
